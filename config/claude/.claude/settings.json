{
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr edit*--enable-auto-merge*)",
      "Bash(gh api*/merge*)",
      "Bash(gh api*/pulls/*/merge*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "hey@37signals": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "37signals": {
      "source": {
        "source": "github",
        "repo": "basecamp/claude-plugins"
      }
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark-ansi",
  "editorMode": "vim",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "sandbox": {
    "enabled": true
  }
}

