Host fermium
  HostName fermium.local
  User vahid

# ┌┬┐┌─┐┌─┐┌─┐┬ ┬┬ ┌┬┐┌─┐
#  ││├┤ ├┤ ├─┤│ ││  │ └─┐
# ─┴┘└─┘└  ┴ ┴└─┘┴─┘┴ └─┘

Host *
  User hallaji
  IdentityAgent "${SSH_AUTH_SOCK}"
  ServerAliveInterval 60
  ServerAliveCountMax 3
  ForwardAgent yes
  StrictHostKeyChecking ask
